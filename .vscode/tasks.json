{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Varejo: iniciar API local",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "uvicorn",
        "src.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Varejo: testes locais",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "tests",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Varejo: validar e exportar exemplo",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "src.retail.demo",
        "${workspaceFolder}/examples/retail-demo.json",
        "${workspaceFolder}/examples/generated"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend"
        }
      },
      "problemMatcher": [],
      "detail": "I0: gera retail-layout.dxf, retail-layout.svg e validation.json em diretório novo ou vazio, sem servidor remoto."
    }
  ]
}
